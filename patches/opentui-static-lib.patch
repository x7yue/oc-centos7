+    return null;
+}
+
+fn addYogaWithSystemCxx(b: *std.Build, module: *std.Build.Module, yoga_dep: *std.Build.Dependency) *std.Build.Step.InstallFile {
+    const sysroot = "/opt/linux-sysroot-musl";
+    const cxx = sysroot ++ "/usr/include/c++/15.2.0";
+    const base_args = [_][]const u8{
+        "/usr/lib/llvm-21/bin/clang++", "--target=x86_64-linux-musl", "-c", "-std=c++20", "-O2",
+        "-fexceptions", "-frtti", "-nostdinc", "--sysroot=" ++ sysroot,
+        "-isystem", cxx,
+        "-isystem", cxx ++ "/x86_64-alpine-linux-musl",
+        "-isystem", cxx ++ "/backward",
+        "-isystem", sysroot ++ "/usr/include",
+        "-isystem", sysroot ++ "/usr/include/x86_64-alpine-linux-musl",
+        "-D_GNU_SOURCE",
+    };
+
+    var objs: [YOGA_CXX_SOURCES.len]std.Build.LazyPath = undefined;
+    const yoga_root = yoga_dep.path("").getPath(b);
+    for (YOGA_CXX_SOURCES, 0..) |src, i| {
+        const cmd = b.addSystemCommand(&base_args);
+        cmd.addArg("-isystem");
+        cmd.addArg(yoga_root);
+        cmd.addFileArg(yoga_dep.path(src));
+        cmd.addArg("-o");
+        objs[i] = cmd.addOutputFileArg(b.fmt("yoga-cxx-{d}.o", .{i}));
+    }
+
+    const ar = b.addSystemCommand(&.{ "ar", "rcs" });
+    const lib = ar.addOutputFileArg("libyoga_cxx.a");
+    for (objs) |obj| ar.addFileArg(obj);
+    module.addIncludePath(yoga_dep.path(""));
+    return b.addInstallFileWithDir(lib, .{ .custom = "../lib/x86_64-linux-musl" }, "libyoga_cxx.a");
 }
 
